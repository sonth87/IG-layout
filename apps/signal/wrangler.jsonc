// Booth signaling (docs/discussions/2026-10-29-photobooth.md): one Durable Object per room code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ig-layout-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Comma-separated; a page from any other origin can't open a room.
    "ALLOWED_ORIGINS": "http://localhost:*,https://ig-layout.vercel.app"
  }
}
