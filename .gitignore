# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e output
apps/web/e2e/.out/
apps/web/public/ort/
apps/web/public/emoji/

# Reference screenshots / videos of other apps (not ours: never committed)
/refs/

# M20 asset sources: originals are re-downloadable from each item's source.url
/assets/**/src/
/assets/**/review.html
/assets/_review/

# Generated at build (scripts/build-licenses.mjs)
apps/web/public/licenses.txt

/sample

# SCRL reference screenshots (owner, large)
/sample/

# Cloudflare worker (apps/signal)
.wrangler/
.dev.vars
